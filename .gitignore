# tmp/ is both the build directory and the worktree root, so nothing under it is tracked.
tmp/
dist/
coverage/

# The leading slash is load-bearing: an unanchored "wnc" also matched the directory
# internal/wnc/ and left the whole SDK layer untracked and invisible to "git add .".
/wnc
*.exe
*.test

*.out

.idea/
*.swp
*.swo
.DS_Store

# Agent files
# The trailing "*" is load-bearing: written as ".claude/" git never descends into the
# directory, and the negation below cannot re-include the AGENTS.md symlink.
.claude/*
!.claude/CLAUDE.md
