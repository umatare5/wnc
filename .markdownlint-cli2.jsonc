{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "default": true,
    "MD003": { "style": "atx" },
    "MD004": { "style": "dash" },
    "MD013": false,
    "MD024": { "siblings_only": true },
    // Two adjacent GitHub alerts cannot be written without a blank line between them
    "MD028": false,
    "MD029": { "style": "ordered" },
    "MD046": { "style": "fenced" },
    "MD048": { "style": "backtick" },
    "MD050": { "style": "asterisk" },
    "MD054": { "url_inline": false },
    "MD055": { "style": "leading_and_trailing" },
    "MD060": { "style": "aligned", "aligned_delimiter": true }
  },
  "overrides": [
    {
      "filter": ["AGENTS.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Repository Instructions",
            "## Tech Stack", "*",
            "## Repository Structure", "*",
            "## Setup and Commands", "*",
            "## Code Style", "*",
            "## Testing", "*",
            "## Commits and PRs", "*",
            "## Domain Knowledge", "*"
          ]
        }
      }
    },
    {
      "filter": ["CHANGELOG.md"],
      "combine": "merge",
      "config": {
        // Release headings accrue and this repository opens each one directly as
        // `## [vX.Y.Z]`, so only the title is pinned
        "MD043": {
          "match_case": true,
          "headings": [
            "# Changelog",
            "*"
          ]
        }
      }
    },
    {
      "filter": ["CONTRIBUTING.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Contributing",
            "## Commands", "*",
            "## Build", "*",
            "## Release", "*",
            "## Pull requests"
          ]
        }
      }
    },
    {
      "filter": ["README.md"],
      "combine": "merge",
      "config": {
        // The logo, badges and title block are HTML; the heading they carry is an <h1>
        "MD033": {
          "allowed_elements": ["a", "br", "div", "h1", "img", "p", "picture", "source"]
        },
        "MD041": { "allow_preamble": true },
        "MD043": {
          "match_case": true,
          "headings": [
            "## Overview", "*",
            "## Supported Environment", "*",
            "## Quick Start", "*",
            "## Syntax", "*",
            "## Configuration", "*",
            "## Troubleshooting", "*",
            "## Contributing", "*",
            "## Acknowledgement", "*",
            "## Licence"
          ]
        }
      }
    },
    {
      // An index, then the contracts no single page owns. A section beyond those
      // two would be a fact the page it points at already carries.
      "filter": ["docs/README.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": ["# Documentation", "## Technical Information", "*"]
        }
      }
    },
    {
      // The policy sections the OSS corpus settles on, pinned exactly: this file states
      // what is reported and how, and never how to operate the CLI. Hardening guidance
      // belongs to docs/configuration.md and docs/troubleshooting.md.
      "filter": ["SECURITY.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Security Policy",
            "## Supported Versions",
            "## Reporting a Vulnerability",
            "## What to Include",
            "## Scope"
          ]
        }
      }
    },
    {
      "filter": ["docs/testing.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Testing",
            "## How the suite is arranged", "*",
            "## Fixture Identities", "*",
            "## The RESTCONF layer", "*",
            "## The fan-out", "*",
            "## The command tree", "*",
            "## Invariants", "*",
            "## Against a real controller"
          ]
        }
      }
    },
    {
      // The sole owner of every reading taken on a live controller. The subject
      // sections are closed: a new one would mean a subject the CLI does not reach.
      "filter": ["docs/measurements.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Measurements",
            "## Device heading map",
            "## Access point",
            "## Radio",
            "## Client",
            "## Tag",
            "## Configuration",
            "## Not measured"
          ]
        }
      }
    },
    {
      // One section per command, so the file grows a heading whenever the command
      // tree does. Only the title is pinned.
      "filter": ["docs/help.md"],
      "combine": "merge",
      "config": {
        "MD043": { "match_case": true, "headings": ["# Help", "*"] }
      }
    },
    {
      "filter": ["docs/configuration.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Configuration",
            "## Flags", "*",
            "## Environment Variables", "*",
            "## Configuration File", "*",
            "## Where to Keep the Token"
          ]
        }
      }
    },
    {
      // One section per cause token and per symptom, so the same applies.
      "filter": ["docs/troubleshooting.md"],
      "combine": "merge",
      "config": {
        "MD043": { "match_case": true, "headings": ["# Troubleshooting", "*"] }
      }
    },
    {
      // The nine read commands, pinned exactly: the leading wildcard is the per-page
      // title alone. A per-command section would break the uniform skeleton, so a
      // fact that has nowhere else to go belongs in Notes.
      "filter": ["docs/commands/show-*.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": ["*", "## Flags", "## Columns", "## Notes", "## Examples"]
        }
      }
    },
    {
      // The six commands that name a target and write it. Pinned exactly for the same
      // reason as the read pages. Columns is present and says the command prints no
      // table, so a reader finds the same seven sections on every one.
      "filter": [
        "docs/commands/deauth.md",
        "docs/commands/delete-tag.md",
        "docs/commands/enable-disable.md",
        "docs/commands/reset-ap.md",
        "docs/commands/reset-capwap.md",
        "docs/commands/set-tag.md"
      ],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "*", "## Flags", "## Columns", "## The target",
            "## Guards", "## Exit codes", "## Notes", "## Examples"
          ]
        }
      }
    },
    {
      // save-config names no target, so it takes neither the uniform skeleton nor a
      // Columns section. Its two opening sections carry why the command exists at all.
      "filter": ["docs/commands/save-config.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "*", "## Flags", "## Why this exists", "## What a save covers",
            "## Guards", "## Exit codes", "## Notes", "## Examples"
          ]
        }
      }
    },
    {
      // The one command that contacts no controller, so it has no guard, no exit
      // code of its own and nothing to demonstrate against a device.
      "filter": ["docs/commands/generate-token.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": ["*", "## Flags", "## Notes", "## Storing the result"]
        }
      }
    }
  ],
  "globs": ["**/*.md"],
  // "gitignore": true is deliberately not set: it would drop the wnc-developer
  // skill under .claude/, which .gitignore keeps untracked but which is still
  // written to this repository's standard.
  "ignores": [
    "tmp/**",
    "vendor/**",
    // Both are symlinks to AGENTS.md; linting the target once is enough.
    ".github/copilot-instructions.md",
    ".claude/CLAUDE.md"
  ]
}
